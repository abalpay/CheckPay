NEXT_PUBLIC_APP_URL="http://localhost:3000"

# BACKEND_URL: injected automatically by the Vercel Services binding (see vercel.json).
# Do not set this manually on Vercel.

# FASTAPI_RECONCILE_URL: local-only fallback for /api/reconcile, used when BACKEND_URL
# isn't set (e.g. running `npm run dev` + a local uvicorn instead of `vercel dev`).
FASTAPI_RECONCILE_URL="http://localhost:8000/api/reconcile"
